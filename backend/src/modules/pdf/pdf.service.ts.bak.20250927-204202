// src/modules/pdf/pdf.service.ts
import { Injectable, Logger } from '@nestjs/common';
import * as Minio from 'minio';

type PutResult = { key: string; url: string; created: boolean };

@Injectable()
export class PdfService {
  private readonly logger = new Logger(PdfService.name);
  private readonly bucket = 'evidencias';
  private readonly publicBase: string;
  private readonly client: Minio.Client;

  constructor() {
    const endpoint = process.env.MINIO_ENDPOINT || 'minio:9000';
    const [endHost, endPort] = endpoint.includes(':') ? endpoint.split(':') : [endpoint, '9000'];

    this.client = new Minio.Client({
      endPoint: endHost,
      port: parseInt(endPort, 10),
      useSSL: String(process.env.MINIO_USE_SSL || 'false') === 'true',
      accessKey: process.env.MINIO_ACCESS_KEY || 'minioadmin',
      secretKey: process.env.MINIO_SECRET_KEY || 'minioadmin',
    });

    const defaultBase = 'http://127.0.0.1:9000/evidencias/';
    this.publicBase = (process.env.MINIO_PUBLIC_BASE || defaultBase).replace(/\/+$/, '/') ;
  }

  publicUrl(key: string): string {
    return `${this.publicBase}${key.replace(/^\/+/, '')}`;
  }

  private async ensureBucket(): Promise<void> {
    try {
      const exists = await this.client.bucketExists(this.bucket);
      if (!exists) {
        await this.client.makeBucket(this.bucket, '');
        this.logger.log(`Bucket ${this.bucket} creado`);
      }
    } catch (err: any) {
      if (err?.code !== 'BucketAlreadyOwnedByYou' && err?.code !== 'BucketAlreadyExists') {
        throw err;
      }
    }
  }

  private parsePayload(
    payload: Buffer | string,
    explicitContentType?: string,
  ): { buf: Buffer; contentType: string } {
    let ct = explicitContentType || 'application/octet-stream';

    if (typeof payload === 'string') {
      // data URL?
      if (payload.startsWith('data:')) {
        const m = payload.match(/^data:([^;]+);base64,(.*)$/);
        if (!m) throw new Error('Invalid data URL for upload');
        ct = m[1] || ct;
        return { buf: Buffer.from(m[2], 'base64'), contentType: ct };
      }
      // base64 “puro” o texto
      try {
        const b = Buffer.from(payload, 'base64');
        // Heurística: si parece binario tras base64, lo tomamos
        if (b.length > 0) return { buf: b, contentType: ct };
      } catch {
        // ignore
      }
      return { buf: Buffer.from(payload), contentType: ct };
    }

    return { buf: payload, contentType: ct };
  }

  /** Sube un objeto al bucket y devuelve { key, url, created }. Acepta Buffer o data URL. */
  async putObject(
    key: string,
    payload: Buffer | string,
    contentType?: string,
    metadata?: Record<string, string>,
  ): Promise<PutResult> {
    await this.ensureBucket();
    const { buf, contentType: ct } = this.parsePayload(payload, contentType);
    await this.client.putObject(
      this.bucket,
      key,
      buf,
      buf.length,
      { 'Content-Type': ct, ...(metadata || {}) },
    );
    return { key, url: this.publicUrl(key), created: true };
  }

  /** Garantiza un PDF mínimo en `key` si no existe. */
  async ensure(key: string): Promise<PutResult> {
    await this.ensureBucket();
    try {
      await this.client.statObject(this.bucket, key);
      return { key, url: this.publicUrl(key), created: false };
    } catch (err: any) {
      // En MinIO, si no existe: NotFound / NoSuchKey
      if (!err?.code || !String(err.code).toLowerCase().includes('not')) {
        // Códigos distintos a "no existe": relanzar
        // (p.ej. credenciales, network, etc.)
        this.logger.warn(`statObject(${key}) => ${err?.code || err}`);
      }
    }

    const pdf = this.generateMinimalPdf();
    await this.client.putObject(
      this.bucket,
      key,
      pdf,
      pdf.length,
      { 'Content-Type': 'application/pdf', 'Cache-Control': 'public, max-age=600' },
    );
    return { key, url: this.publicUrl(key), created: true };
  }

  /** PDF ultra mínimo (1 página) para placeholders. */
  private generateMinimalPdf(): Buffer {
    // Un PDF mínimo válido
    const content =
      '%PDF-1.4\n' +
      '1 0 obj<<>>endobj\n' +
      '2 0 obj<</Type/Catalog/Pages 3 0 R>>endobj\n' +
      '3 0 obj<</Type/Pages/Count 1/Kids[4 0 R]>>endobj\n' +
      '4 0 obj<</Type/Page/Parent 3 0 R/MediaBox[0 0 200 200]/Contents 5 0 R>>endobj\n' +
      '5 0 obj<</Length 44>>stream\nBT /F1 12 Tf 10 100 Td (Placeholder PDF) Tj ET\nendstream\nendobj\n' +
      'xref\n0 6\n0000000000 65535 f \n0000000010 00000 n \n0000000051 00000 n \n0000000101 00000 n \n0000000163 00000 n \n0000000257 00000 n \n' +
      'trailer<</Size 6/Root 2 0 R>>\nstartxref\n340\n%%EOF\n';
    return Buffer.from(content, 'utf8');
  }
}

