// Reemplazo drop-in del cierre técnico con firma/fotos/materiales + PDF real
import { Controller, Post, Param, Body } from '@nestjs/common';
import { DataSource } from 'typeorm';
import { PdfService } from '../../pdf/pdf.service';

@Controller('v1/tecnicos/:tecnicoId/ordenes/codigo')
export class TecnicosCierreController {
  constructor(
    private readonly db: DataSource,
    private readonly pdf: PdfService,
  ) {}

  @Post(':codigo/iniciar')
  async iniciar(
    @Param('tecnicoId') tecnicoId: string,
    @Param('codigo') codigo: string,
  ) {
    // Idempotente: solo registra evento de inicio si existe la orden
    const { rowCount } = await this.db.query(
      `UPDATE ordenes SET iniciada_at = COALESCE(iniciada_at, now())
       WHERE codigo = $1`,
      [codigo],
    );
    return { _idempotent: rowCount === 0 };
  }

  @Post(':codigo/cerrar')
  async cerrar(
    @Param('tecnicoId') tecnicoId: string,
    @Param('codigo') codigo: string,
    @Body() body: any,
  ) {
    // 0) Resolver orden
    const qOrden = await this.db.query(
      `SELECT id FROM ordenes WHERE codigo=$1 LIMIT 1`,
      [codigo],
    );
    if (!qOrden.length) {
      return { message: 'Orden no encontrada', error: 'Not Found', statusCode: 404 };
    }
    const ordenId = qOrden[0].id;

    // 1) Firma
    if (body?.firmaBase64) {
      const firmaKey = `firmas/${codigo}.png`;
      await this.pdf.putObject(
        firmaKey,
        decodeDataUrl(body.firmaBase64),
        'image/png',
        { 'Cache-Control': 'public, max-age=600' },
      );
      await this.db.query(
        `INSERT INTO orden_evidencias(orden_id, tipo, key, created_at)
         VALUES ($1,'firma',$2, now())
         ON CONFLICT DO NOTHING`,
        [ordenId, firmaKey],
      );
    }

    // 2) Evidencias (fotos)
    if (Array.isArray(body?.evidenciasBase64)) {
      let i = 0;
      for (const dataUrl of body.evidenciasBase64) {
        i++;
        const fotoKey = `fotos/${codigo}-${i}.png`;
        await this.pdf.putObject(
          fotoKey,
          decodeDataUrl(dataUrl),
          'image/png',
          { 'Cache-Control': 'public, max-age=600' },
        );
        await this.db.query(
          `INSERT INTO orden_evidencias(orden_id, tipo, key, created_at)
           VALUES ($1,'foto',$2, now())
           ON CONFLICT DO NOTHING`,
          [ordenId, fotoKey],
        );
      }
    }

    // 3) Materiales del cierre
    if (Array.isArray(body?.materiales)) {
      for (const m of body.materiales) {
        await this.db.query(
          `INSERT INTO orden_materiales(orden_id, material_id_int, cantidad, created_at)
           VALUES ($1,$2,$3, now())
           ON CONFLICT DO NOTHING`,
          [ordenId, m.materialIdInt, m.cantidad],
        );
      }
    }

    // 4) Generar/asegurar PDF y URL pública
    const pdfKey = `pdfs/${codigo}.pdf`;
    const pdfUrl = await this.pdf.ensurePdf(pdfKey);

    // 5) Cerrar orden con pdf_url
    await this.db.query(
      `UPDATE ordenes
          SET estado='cerrada',
              cerrada_at=now(),
              pdf_key=$2,
              pdf_url=$3
        WHERE id=$1`,
      [ordenId, pdfKey, pdfUrl],
    );

    return {
      codigo,
      estado: 'cerrada',
      cerradaAt: new Date().toISOString(),
      pdfUrl,
      _idempotent: false,
    };
  }
}

// Helper dataURL -> Buffer
function decodeDataUrl(dataUrl: string): Buffer {
  const idx = dataUrl.indexOf('base64,');
  const b64 = idx >= 0 ? dataUrl.slice(idx + 7) : dataUrl;
  return Buffer.from(b64, 'base64');
}
