{
  "name": "isp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "echo \"no tests\"",
    "test:e2e": "cross-env API_BASE=http://127.0.0.1:3000/v1 jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "m:show": "NODE_ENV=production node ./node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "m:run": "NODE_ENV=production node ./node_modules/typeorm/cli.js migration:run  -d dist/database/data-source.js",
    "m:revert": "NODE_ENV=production node ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "m:show:ts": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "m:run:ts": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:run  -d src/database/data-source.ts",
    "m:revert:ts": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "print:ds:dist": "NODE_ENV=production node -p \"require('./dist/database/data-source.js').default.options.migrations\"",
    "migration:show": "npm run m:show",
    "migration:run": "npm run m:run",
    "migration:revert": "npm run m:revert",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/AutoMigration",
    "smoke:ins-equipos": "bash script/smoke_ins_equipos_cierre.sh",
    "smoke:ins-equipos:ont": "TIPO=ONT SER=ONT-ABC-001 bash script/smoke_ins_equipos_cierre.sh",
    "smoke:ins-equipos:repeater": "TIPO=REPEATER SER=REP-XYZ-123 bash script/smoke_ins_equipos_cierre.sh"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/typeorm": "^10.0.0",
    "argon2": "^0.40.3",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "minio": "^8.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.127",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
